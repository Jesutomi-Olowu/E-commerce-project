# Generate with: npx auth secret   (or openssl rand -base64 32)
AUTH_SECRET=
# Amplify does not allow env vars starting with AWS_, so we use APP_REGION
APP_REGION=eu-west-1
USERS_TABLE=Users
PRODUCTS_TABLE=Products
ORDERS_TABLE=Orders
IMAGES_BUCKET=
FILES_BUCKET=
# CloudFront (or bucket) URL that serves product images, no trailing slash
IMAGES_BASE_URL=
PAYSTACK_SECRET_KEY=
APP_URL=http://localhost:3000
# Your commission, as a percent. Placeholder: decide your own rate.
PLATFORM_FEE_PERCENT=10
